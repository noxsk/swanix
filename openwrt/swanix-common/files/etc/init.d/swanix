#!/bin/sh /etc/rc.common
# swanix multi-WAN controller

USE_PROCD=1
START=25
STOP=89

PROG=/usr/bin/swanix

start_service() {
	[ "$(uci -q get swanix.global.enabled)" = "1" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# The kernel objects (nft table, ip rules, routing tables) are deliberately
# left in place when the daemon stops, so established connections keep their
# path while procd restarts it. Health scheduling is paused in that window.
# Use `swanix rollback` or `swanix remove` to withdraw them.
stop_service() {
	:
}

reload_service() {
	"$PROG" reconcile >/dev/null 2>&1 || restart
}

service_triggers() {
	# no config trigger on purpose: configuration changes go through
	# `swanix apply`, which validates first and keeps a rollback window
	:
}
