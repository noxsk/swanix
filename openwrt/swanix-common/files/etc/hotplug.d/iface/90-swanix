#!/bin/sh
# Wake the daemon on interface events; it also watches netlink and reconciles
# periodically, so a missed event is not fatal.
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ] || [ "$ACTION" = "ifupdate" ] || exit 0
[ -S /var/run/swanix/control.sock ] || exit 0
/usr/bin/swanix reconcile >/dev/null 2>&1 &
exit 0
